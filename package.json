{
  "name": "oro-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "clean": "node tools/clean.ts",
    "build": "npm run clean && domstack",
    "start": "domstack --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "audit": "node tools/audit-output.ts",
    "test:site": "node --test tests/site/*.test.ts",
    "test:browser": "playwright test",
    "test:reproducibility": "node tools/reproducibility.ts",
    "audit:content": "node tools/audit-content.ts",
    "test:tooling": "node --test tests/tooling/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run audit && npm run audit:content && npm run test:site && npm run test:browser && npm run test:tooling && npm run test:reproducibility"
  },
  "devDependencies": {
    "@domstack/static": "12.0.0-beta.9",
    "@playwright/test": "^1.55.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "cheerio": "^1.1.2",
    "fragtml": "0.0.10",
    "highlight.js": "^11.11.1",
    "js-yaml": "^5.4.2",
    "markdown-it": "^15.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "typescript": "^5.9.2"
  }
}
